# backhaul/ws node side
=== file client.toml
# Rendered by deyroute for tunnel main, node de-1, transport backhaul/ws (node side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
[client]
remote_addr = "5.6.7.8:30001"
transport = "ws"
token = "tok-test"
connection_pool = 8
aggressive_pool = false
keepalive_period = 75
dial_timeout = 10
nodelay = true
retry_interval = 3
sniffer = false
web_port = 0
log_level = "info"
skip_optz = true
