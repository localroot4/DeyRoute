# backhaul/tcp hub side
=== file server.toml
# Rendered by deyroute for tunnel main, node de-1, transport backhaul/tcp (hub side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
[server]
bind_addr = "0.0.0.0:30001"
transport = "tcp"
accept_udp = false
token = "tok-test"
keepalive_period = 75
nodelay = true
heartbeat = 20
channel_size = 2048
sniffer = false
web_port = 0
log_level = "info"
skip_optz = true
ports = [
  "443=127.0.0.1:443",
  "2053=127.0.0.1:2053",
]
