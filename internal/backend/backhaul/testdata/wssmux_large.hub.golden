# backhaul/wssmux hub side
=== file server.toml
# Rendered by deyroute for tunnel main, node de-1, transport backhaul/wssmux (hub side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
[server]
bind_addr = "0.0.0.0:30001"
transport = "wssmux"
token = "tok-test"
keepalive_period = 75
nodelay = true
heartbeat = 20
channel_size = 4096
mux_con = 8
mux_version = 1
mux_framesize = 32768
mux_recievebuffer = 8388608
mux_streambuffer = 65536
sniffer = false
web_port = 0
tls_cert = "/etc/deyroute/backends/backhaul/main/de-1/wssmux/cert.pem"
tls_key = "/etc/deyroute/backends/backhaul/main/de-1/wssmux/key.pem"
log_level = "info"
skip_optz = true
ports = [
  "443=127.0.0.1:443",
  "2053=127.0.0.1:2053",
]
