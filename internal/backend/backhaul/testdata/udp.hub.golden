# backhaul/udp hub side
=== file server.toml
# Rendered by deyroute for tunnel main, node de-1, transport backhaul/udp (hub side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
[server]
bind_addr = "0.0.0.0:30001"
transport = "udp"
token = "tok-test"
heartbeat = 20
channel_size = 2048
sniffer = false
web_port = 0
log_level = "info"
skip_optz = true
ports = [
  "27015=127.0.0.1:27015",
  "5353=127.0.0.1:53",
]
