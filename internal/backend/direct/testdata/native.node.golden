  ],
  "ExecStartPre": null,
  "ExecStop": null,
  "WorkingDirectory": "/etc/deyroute/backends/direct/main/de-1/native",
  "Env": null,
  "Type": "",
  "RemainAfterExit": false,
  "RunAsRoot": false,
  "ExtraCaps": null,
  "DropHardening": null,
