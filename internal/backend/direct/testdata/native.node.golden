# direct/native node side
=== file relay.json
{
  "version": 1,
  "tunnel": "main",
  "role": "node",
  "token": "tok-test",
  "bind": "0.0.0.0:30001",
  "ports": [
    {
      "index": 0,
      "proto": "tcp",
      "target": "127.0.0.1:443"
    },
    {
      "index": 1,
      "proto": "tcp",
      "target": "127.0.0.1:2053"
    }
  ],
  "idle_timeout_s": 300,
  "dial_timeout_s": 10,
  "udp_idle_timeout_s": 60,
  "max_udp_sessions": 4096
}
