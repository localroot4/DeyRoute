# direct/haproxy hub side
=== file haproxy.cfg
# Rendered by deyroute for tunnel main, node de-1, transport direct/haproxy (hub side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
global
    maxconn 65536

defaults
    mode tcp
    timeout connect 10s
    timeout client 5m
    timeout server 5m
    timeout client-fin 30s
    timeout server-fin 30s
    timeout check 5s

frontend tcp-443
    bind 0.0.0.0:443
    default_backend tcp-443

backend tcp-443
    option tcp-check
    server de-1 1.2.3.4:443 check inter 5s fall 3 rise 2 send-proxy check-send-proxy

frontend tcp-2053
    bind 0.0.0.0:2053
    default_backend tcp-2053

backend tcp-2053
    option tcp-check
    server de-1 1.2.3.4:8443 check inter 5s fall 3 rise 2 send-proxy check-send-proxy
