  ],
  "ExecStartPre": [
    [
      "/usr/sbin/haproxy",
      "-c",
      "-f",
      "/etc/deyroute/backends/direct/main/de-1/haproxy/haproxy.cfg"
    ]
  ],
  "ExecStop": null,
  "WorkingDirectory": "/etc/deyroute/backends/direct/main/de-1/haproxy",
  "Env": null,
  "Type": "",
  "RemainAfterExit": false,
  "RunAsRoot": false,
  "ExtraCaps": null,
  "DropHardening": null,
  "AddressFamilies": null,
  "ReadWritePaths": null
}
