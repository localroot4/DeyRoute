{
  "ExecStart": [
    "/usr/local/bin/deyroute",
    "wg",
    "up",
    "--config",
    "/etc/deyroute/backends/wireguard/main/de-1/kernel/wg.json"
  ],
  "ExecStartPre": null,
  "ExecStop": [
    [
      "/usr/local/bin/deyroute",
      "wg",
      "down",
      "--config",
      "/etc/deyroute/backends/wireguard/main/de-1/kernel/wg.json"
    ]
  ],
  "WorkingDirectory": "/etc/deyroute/backends/wireguard/main/de-1/kernel",
  "Env": null,
