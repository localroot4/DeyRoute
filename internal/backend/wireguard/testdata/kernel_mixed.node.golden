=== unit
{
  "ExecStart": [
    "/usr/local/bin/deyroute",
    "wg",
    "up",
    "--config",
    "/etc/deyroute/backends/wireguard/main/de-1/kernel/wg.json"
  ],
  "ExecStartPre": null,
  "ExecStop": [
    [
      "/usr/local/bin/deyroute",
      "wg",
      "down",
      "--config",
      "/etc/deyroute/backends/wireguard/main/de-1/kernel/wg.json"
    ]
  ],
  "WorkingDirectory": "/etc/deyroute/backends/wireguard/main/de-1/kernel",
  "Env": null,
  "Type": "oneshot",
  "RemainAfterExit": true,
  "RunAsRoot": true,
  "ExtraCaps": [
    "CAP_NET_ADMIN"
  ],
  "DropHardening": {
    "ProtectKernelTunables": "deyroute wg up sets net.ipv4.conf.<iface>.route_localnet=1 so the node can DNAT tunnel traffic to 127.0.0.1 targets"
  },
  "AddressFamilies": [
    "AF_NETLINK"
  ],
  "ReadWritePaths": null
}
