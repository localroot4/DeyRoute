=== unit
{
  "ExecStart": [
    "/var/lib/deyroute/bin/waterwall/v1.46.94/Waterwall"
  ],
  "ExecStartPre": null,
  "ExecStop": null,
  "WorkingDirectory": "/etc/deyroute/backends/waterwall/main/de-1/reverse-reality",
  "Env": null,
  "Type": "",
  "RemainAfterExit": false,
  "RunAsRoot": false,
  "ExtraCaps": null,
  "DropHardening": {
    "MemoryDenyWriteExecute": "the Linux x64 release of Waterwall is a packed executable that restores itself in memory at start (memfd_create + execveat of an anonymous executable file); MemoryDenyWriteExecute (PR_SET_MDWE, inherited across exec) makes that loader fail"
  },
  "AddressFamilies": null,
  "ReadWritePaths": null
}
