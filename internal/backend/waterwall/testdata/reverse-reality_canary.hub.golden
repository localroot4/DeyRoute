# waterwall/reverse-reality hub side
=== file config.json
{
  "name": "deyroute-main-de-1-hub",
  "nodes": [
    {
      "name": "users-inbound",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "nodelay": true,
        "port": 39001
      },
      "next": "bridge-users"
    },
    {
      "name": "bridge-users",
      "type": "Bridge",
      "settings": {
        "pair": "bridge-reverse"
      }
    },
    {
      "name": "bridge-reverse",
      "type": "Bridge",
      "settings": {
        "pair": "bridge-users"
      }
    },
    {
      "name": "reverse-server",
      "type": "ReverseServer",
      "settings": {},
      "next": "bridge-reverse"
    },
    {
      "name": "reality-server",
      "type": "RealityServer",
      "settings": {
        "destination": "reality-decoy",
        "password": "Pw0rdPw0rdPw0rdPw0rdPw0r"
      },
      "next": "reverse-server"
    },
    {
      "name": "node-inbound",
      "type": "TcpListener",
      "settings": {
        "address": "0.0.0.0",
        "nodelay": true,
        "port": 30001,
        "whitelist": [
          "1.2.3.4/32"
        ]
      },
      "next": "reality-server"
    },
    {
      "name": "reality-decoy",
      "type": "TcpConnector",
      "settings": {
        "address": "www.example.com",
        "nodelay": true,
        "port": 443
      }
    }
  ]
}
