# waterwall/reverse-reality node side
=== file config.json
{
  "name": "deyroute-main-de-1-node",
  "nodes": [
    {
      "name": "service-outbound",
      "type": "TcpConnector",
      "settings": {
        "address": "127.0.0.1",
        "nodelay": true,
        "port": 39002
      }
    },
    {
      "name": "bridge-service",
      "type": "Bridge",
      "settings": {
        "pair": "bridge-reverse"
      },
      "next": "service-outbound"
    },
    {
      "name": "bridge-reverse",
      "type": "Bridge",
      "settings": {
        "pair": "bridge-service"
      },
      "next": "reverse-client"
    },
    {
      "name": "reverse-client",
      "type": "ReverseClient",
      "settings": {
        "minimum-unused": 16
      },
      "next": "reality-client"
    },
    {
      "name": "reality-client",
      "type": "RealityClient",
      "settings": {
        "password": "Pw0rdPw0rdPw0rdPw0rdPw0r",
        "sni": "www.example.com"
      },
      "next": "hub-outbound"
    },
    {
      "name": "hub-outbound",
      "type": "TcpConnector",
      "settings": {
        "address": "5.6.7.8",
        "nodelay": true,
        "port": 30001
      }
    }
  ]
}
