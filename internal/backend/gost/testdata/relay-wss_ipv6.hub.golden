# gost/relay-wss hub side
=== file gost.yaml
# Rendered by deyroute for tunnel main, node de-1, transport gost/relay-wss.
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
services:
  - name: relay-wss
    addr: 0.0.0.0:30001
    bypass: deny-local
    handler:
      type: relay
      auth:
        username: dey
        password: tok-test
      metadata:
        bind: true
    listener:
      type: wss
      tls:
        certFile: /etc/deyroute/backends/gost/main/de-1/relay-wss/tls-cert.pem
        keyFile: /etc/deyroute/backends/gost/main/de-1/relay-wss/tls-key.pem
        options:
          minVersion: VersionTLS13
      metadata:
        path: /b7c36e39cff03bb4
bypasses:
  - name: deny-local
    whitelist: false
    matchers:
      - 0.0.0.0/8
      - 169.254.0.0/16
      - ::/128
      - fe80::/10
log:
  output: stderr
  level: info
  format: text
