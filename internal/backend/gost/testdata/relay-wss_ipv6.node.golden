# gost/relay-wss node side
=== file gost.yaml
# Rendered by deyroute for tunnel main, node de-1, transport gost/relay-wss.
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
services:
  - name: tcp-443
    addr: '[::]:443'
    handler:
      type: rtcp
    listener:
      type: rtcp
      chain: hub
    forwarder:
      nodes:
        - name: target
          addr: 127.0.0.1:443
  - name: tcp-2053
    addr: '[::]:2053'
    handler:
      type: rtcp
    listener:
      type: rtcp
      chain: hub
    forwarder:
      nodes:
        - name: target
          addr: 127.0.0.1:2053
  - name: udp-443
    addr: '[::]:443'
    handler:
      type: rudp
    listener:
      type: rudp
      chain: hub
      metadata:
        ttl: 60s
    forwarder:
      nodes:
        - name: target
          addr: 127.0.0.1:443
  - name: udp-27015
    addr: '[::]:27015'
    handler:
      type: rudp
    listener:
      type: rudp
      chain: hub
      metadata:
        ttl: 60s
    forwarder:
      nodes:
        - name: target
          addr: 10.0.0.5:27016
  - name: tcp-9443
    addr: '[::]:9443'
    handler:
      type: rtcp
    listener:
      type: rtcp
      chain: hub
    forwarder:
      nodes:
        - name: target
          addr: '[::1]:9444'
chains:
  - name: hub
    hops:
      - name: hop-0
        nodes:
          - name: hub
            addr: 5.6.7.8:30001
            connector:
              type: relay
              auth:
                username: dey
                password: tok-test
            dialer:
              type: wss
              tls:
                caFile: /etc/deyroute/backends/gost/main/de-1/relay-wss/ca.crt
                options:
                  minVersion: VersionTLS13
              metadata:
                path: /369f3c54073c8e3e
log:
  output: stderr
  level: info
  format: text
