# rathole/tcp node side
=== file client.toml
# Rendered by deyroute for tunnel main, node de-1, transport rathole/tcp (node side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
[client]
remote_addr = "5.6.7.8:30001"
default_token = "tok-test"
heartbeat_timeout = 40
retry_interval = 3

[client.transport]
type = "tcp"

[client.services.tcp-443]
type = "tcp"
local_addr = "127.0.0.1:443"

[client.services.tcp-2053]
type = "tcp"
local_addr = "127.0.0.1:2053"
