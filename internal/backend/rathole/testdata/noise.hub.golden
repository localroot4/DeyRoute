# rathole/noise hub side
=== file server.toml
# Rendered by deyroute for tunnel main, node de-1, transport rathole/noise (hub side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
[server]
bind_addr = "0.0.0.0:30001"
default_token = "tok-test"
heartbeat_interval = 20

[server.transport]
type = "noise"

[server.transport.noise]
pattern = "Noise_NK_25519_ChaChaPoly_BLAKE2s"
local_private_key = "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA="

[server.services.tcp-443]
type = "tcp"
bind_addr = "0.0.0.0:443"

[server.services.tcp-2053]
type = "tcp"
bind_addr = "0.0.0.0:2053"
