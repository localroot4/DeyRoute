# hysteria2/udp node side
=== file server.yaml
# Rendered by deyroute for tunnel main, node de-1, transport hysteria2/udp (node side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
listen: ":30001"
tls:
  cert: "/etc/deyroute/backends/hysteria2/main/de-1/udp/tls-cert.pem"
  key: "/etc/deyroute/backends/hysteria2/main/de-1/udp/tls-key.pem"
  sniGuard: "disable"
auth:
  type: "password"
  password: "tok-test"
obfs:
  type: "salamander"
  salamander:
    password: "b2Jmcy10ZXN0LXBhc3N3b3JkLWZpeGVkLXZhbHVlLTAx"
disableUDP: false
speedTest: false
acl:
  inline:
    - "direct(127.0.0.1, tcp/2053, 127.0.0.1)"
    - "direct(127.0.0.1, tcp/443, 127.0.0.1)"
    - "direct(127.0.0.1, udp/27015, 127.0.0.1)"
    - "direct(127.0.0.1, udp/53, 127.0.0.1)"
    - "direct(panel.internal, tcp/80)"
    - "reject(all)"
masquerade:
  type: "404"
