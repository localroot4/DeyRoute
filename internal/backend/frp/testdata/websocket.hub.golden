# frp/websocket hub side
=== file frps.toml
# Rendered by deyroute for tunnel main, node de-1, transport frp/websocket (hub side).
# Regenerated from /etc/deyroute/config.yaml on every apply; do not edit.
bindAddr = "0.0.0.0"
bindPort = 30001
proxyBindAddr = "0.0.0.0"
allowPorts = [
  { single = 443 },
  { single = 2053 },
]
log.to = "console"
log.level = "info"
log.disablePrintColor = true
auth.method = "token"
auth.token = "tok-test"
transport.maxPoolCount = 32
transport.tcpMux = true
transport.tls.force = true
transport.tls.certFile = "/etc/deyroute/backends/frp/main/de-1/websocket/tls-cert.pem"
transport.tls.keyFile = "/etc/deyroute/backends/frp/main/de-1/websocket/tls-key.pem"
