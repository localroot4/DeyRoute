# Managed by deyroute. Do not edit: this table is replaced on every change.
table inet deyroute {
	set nodes {
		type ipv4_addr
	}

	chain input {
		type filter hook input priority -10; policy accept;
		tcp dport 44433 accept
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		fib daddr type local ip daddr != 127.0.0.0/8 tcp dport 443 dnat ip to 10.77.3.2:443
	}

	chain output {
		type nat hook output priority -100; policy accept;
		fib daddr type local ip daddr != 127.0.0.0/8 tcp dport 443 dnat ip to 10.77.3.2:443
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "dey-main" masquerade
	}

	chain forward {
		type filter hook forward priority -10; policy accept;
		oifname "dey-main" tcp flags & (syn | rst) == syn tcp option maxseg size set rt mtu
		iifname "dey-main" tcp flags & (syn | rst) == syn tcp option maxseg size set 1340
	}
}
