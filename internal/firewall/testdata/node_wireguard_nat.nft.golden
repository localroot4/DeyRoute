# Managed by deyroute. Do not edit: this table is replaced on every change.
table inet deyroute {
	set nodes {
		type ipv4_addr
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "dey-main" fib daddr type local ip daddr != 127.0.0.0/8 tcp dport 443 dnat ip to 127.0.0.1:443
		iifname "dey-main" fib daddr type local ip daddr != 127.0.0.0/8 udp dport 27015 dnat ip to 127.0.0.1:27015
	}

	chain forward {
		type filter hook forward priority -10; policy accept;
		oifname "dey-main" tcp flags & (syn | rst) == syn tcp option maxseg size set rt mtu
		iifname "dey-main" tcp flags & (syn | rst) == syn tcp option maxseg size set 1380
		iifname "dey-main" ct state established,related accept
		iifname "dey-main" ct status dnat accept
		iifname "dey-main" drop
	}
}
