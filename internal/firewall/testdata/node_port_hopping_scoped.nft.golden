# Managed by deyroute. Do not edit: this table is replaced on every change.
table inet deyroute {
	set nodes {
		type ipv4_addr
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		fib daddr type local ip saddr { 5.6.7.8 } ip daddr 1.2.3.4 udp dport 20000-20999 redirect to :30123
	}
}
